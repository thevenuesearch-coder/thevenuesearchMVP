NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HERO_VIDEO_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADMIN_EMAIL=thevenuesearch@gmail.com

# Instant booking fee (INR). Read by both the client (to display
# the amount) and the server (to charge it via Razorpay) — keep
# this as the one place that number is set.
NEXT_PUBLIC_BOOKING_FEE_INR=25000

# Booking enquiry email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Venue Search <enquiries@your-verified-domain.com>

# Booking review email (Nodemailer/SMTP) — used by
# /api/booking-review. Not required for the main booking flow.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
